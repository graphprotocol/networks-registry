{
  "id": "bsc",
  "shortName": "BNB",
  "fullName": "BNB Smart Chain Mainnet",
  "aliases": ["bnb", "bnb-mainnet", "bsc-mainnet", "evm-56"],
  "caip2Id": "eip155:56",
  "graphNode": { "protocol": "ethereum" },
  "explorerUrls": ["https://bscscan.com"],
  "rpcUrls": [
    "https://bsc.rpc.pinax.network",
    "https://bsc.rpc.sentio.xyz",
    "https://api.zan.top/bsc-mainnet",
    "https://rpc.graphops.xyz/v1/evm/56/{GRAPHOPS_API_KEY}"
  ],
  "apiUrls": [
    { "url": "https://bsc.abi.thegraph.com/api", "kind": "etherscan" }
  ],
  "networkType": "mainnet",
  "services": {
    "subgraphs": [
      {
        "kind": "gateway",
        "provider": "https://gateway.thegraph.com/api",
        "queryUrls": {
          "subgraphId": "https://gateway.thegraph.com/api/{API_KEY}/subgraphs/id/{SUBGRAPH_ID}",
          "deploymentId": "https://gateway.thegraph.com/api/{API_KEY}/deployments/id/{DEPLOYMENT_ID}"
        },
        "description": "The Graph's canonical Subgraph gateway under www.thegraph.com routes data consumers' GraphQL queries to the Indexers on The Graph Network."
      },
      {
        "kind": "gateway",
        "provider": "https://subgraphs.graphops.xyz/v1",
        "queryUrls": {
          "subgraphId": "https://subgraphs.graphops.xyz/v1/subgraphId/{SUBGRAPH_ID}/{API_KEY}",
          "deploymentId": "https://subgraphs.graphops.xyz/v1/deploymentCID/{DEPLOYMENT_ID}/{API_KEY}"
        },
        "description": "GraphOps routes GraphQL queries for any Subgraph on The Graph Network, authenticated with a GraphOps API key."
      },
      {
        "kind": "curation",
        "provider": "the-graph-foundation",
        "description": "The Graph Foundation will provide curation support for all published Subgraphs on BNB Smart Chain Mainnet until October 8, 2026."
      }
    ],
    "firehose": ["bsc.firehose.pinax.network:443", "bnb.streamingfast.io:443"],
    "substreams": [
      "bsc.substreams.pinax.network:443",
      "bnb.streamingfast.io:443"
    ],
    "tokenApi": ["https://api.pinax.network"]
  },
  "issuanceRewards": true,
  "nativeToken": "BNB",
  "docsUrl": "https://docs.bnbchain.org",
  "indexerDocsUrls": [
    {
      "url": "https://docs.infradao.com/archive-nodes-101/binance",
      "description": "Archive Nodes 101"
    }
  ],
  "firehose": {
    "blockType": "sf.ethereum.type.v2.Block",
    "evmExtendedModel": true,
    "bufUrl": "https://buf.build/streamingfast/firehose-ethereum",
    "bytesEncoding": "hex",
    "firstStreamableBlock": {
      "id": "0x0d21840abff46b96c84b2ac9e10e4f5cdaeb5693cb665db62a2f3b02d2d57b5b",
      "height": 0
    },
    "blockFeatures": ["extended"]
  },
  "tokenApi": { "features": ["tokens", "dexes", "nfts"], "networkId": "bsc" },
  "icon": { "web3Icons": { "name": "binance-smart-chain" } }
}
