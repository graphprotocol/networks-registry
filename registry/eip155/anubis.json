{
  "id": "anubis",
  "shortName": "Anubis",
  "fullName": "Anubis Mainnet",
  "aliases": ["evm-6714", "anubis-mainnet"],
  "caip2Id": "eip155:6714",
  "graphNode": { "protocol": "ethereum" },
  "explorerUrls": ["https://browser.anubispace.org"],
  "rpcUrls": ["https://rpc.anubispace.org"],
  "apiUrls": [
    { "url": "https://browser.anubispace.org/api", "kind": "blockscout" }
  ],
  "networkType": "mainnet",
  "services": {
    "subgraphs": [
      {
        "kind": "gateway",
        "provider": "https://gateway.thegraph.com/api",
        "description": "The Graph's canonical Subgraph gateway under www.thegraph.com routes data consumers' GraphQL queries to the Indexers on The Graph Network."
      },
      {
        "kind": "backstop",
        "provider": "infradao",
        "description": "InfraDAO provides backstop support for Subgraphs with 500 GRT in signal"
      }
    ]
  },
  "issuanceRewards": false,
  "nativeToken": "gasDAI",
  "docsUrl": "https://anubis-network.gitbook.io/anubis-network"
}
