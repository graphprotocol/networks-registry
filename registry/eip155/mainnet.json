{
  "id": "mainnet",
  "shortName": "Ethereum",
  "fullName": "Ethereum Mainnet",
  "aliases": ["ethereum", "eth", "eth-mainnet", "evm-1"],
  "caip2Id": "eip155:1",
  "graphNode": { "protocol": "ethereum" },
  "explorerUrls": ["https://etherscan.io"],
  "rpcUrls": [
    "https://mainnet.gateway.tenderly.co",
    "https://eth.rpc.pinax.network",
    "https://eth.drpc.org",
    "https://rpc.graphops.xyz/v1/evm/1/{GRAPHOPS_API_KEY}"
  ],
  "apiUrls": [
    { "url": "https://mainnet.abi.thegraph.com/api", "kind": "etherscan" },
    { "url": "https://eth.blockscout.com/api", "kind": "blockscout" },
    {
      "url": "https://api.routescan.io/v2/network/mainnet/evm/1/etherscan/api",
      "kind": "etherscan"
    }
  ],
  "networkType": "mainnet",
  "services": {
    "subgraphs": [
      {
        "kind": "gateway",
        "provider": "https://gateway.thegraph.com/api",
        "queryUrls": {
          "subgraphId": "https://gateway.thegraph.com/api/{API_KEY}/subgraphs/id/{SUBGRAPH_ID}",
          "deploymentId": "https://gateway.thegraph.com/api/{API_KEY}/deployments/id/{DEPLOYMENT_ID}"
        },
        "description": "The Graph's canonical Subgraph gateway under www.thegraph.com routes data consumers' GraphQL queries to the Indexers on The Graph Network."
      },
      {
        "kind": "gateway",
        "provider": "https://subgraphs.graphops.xyz/v1",
        "queryUrls": {
          "subgraphId": "https://subgraphs.graphops.xyz/v1/subgraphId/{SUBGRAPH_ID}/{API_KEY}",
          "deploymentId": "https://subgraphs.graphops.xyz/v1/deploymentCID/{DEPLOYMENT_ID}/{API_KEY}"
        },
        "description": "GraphOps routes GraphQL queries for any Subgraph on The Graph Network, authenticated with a GraphOps API key."
      },
      {
        "kind": "studio",
        "provider": "https://api.studio.thegraph.com/deploy",
        "description": "Subgraph Studio is The Graph's developer portal for managing API keys and usage-based billing (via card or GRT) as well as deploying, testing, and publishing Subgraphs to The Graph Network."
      }
    ],
    "firehose": [
      "eth.firehose.pinax.network:443",
      "mainnet.eth.streamingfast.io:443",
      "eth.firehose.data.nexus:443"
    ],
    "substreams": [
      "eth.substreams.pinax.network:443",
      "mainnet.eth.streamingfast.io:443",
      "eth.substreams.data.nexus:443"
    ],
    "tokenApi": ["https://api.pinax.network"]
  },
  "issuanceRewards": true,
  "nativeToken": "ETH",
  "docsUrl": "https://ethereum.org/en/developers/docs",
  "indexerDocsUrls": [
    {
      "url": "https://docs.infradao.com/archive-nodes-101/ethereum",
      "description": "Archive Nodes 101"
    }
  ],
  "firehose": {
    "blockType": "sf.ethereum.type.v2.Block",
    "evmExtendedModel": true,
    "bufUrl": "https://buf.build/streamingfast/firehose-ethereum",
    "bytesEncoding": "hex",
    "firstStreamableBlock": {
      "id": "0xd4e56740f876aef8c010b86a40d5f56745a118d0906a34e69aec8c0db1cb8fa3",
      "height": 0
    },
    "blockFeatures": ["extended"]
  },
  "tokenApi": {
    "features": ["tokens", "dexes", "nfts"],
    "networkId": "mainnet"
  },
  "icon": { "web3Icons": { "name": "ethereum" } }
}
